[Desktop Entry]
Name=ClipDen
GenericName=Clipboard Manager
Comment=Everything you copy. One place to keep.
Exec=/usr/bin/clipden %U
Icon=clipden
Terminal=false
Type=Application
Categories=Utility;Office;GTK;
Keywords=clipboard;history;manager;copy;paste;supabase;
StartupNotify=true
StartupWMClass=clipden
